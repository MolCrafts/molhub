# The partner repositories molhub is built and tested against.
# scripts/partners.py resolves them, for every workflow
# (MolCrafts/molcrafts-ci/actions/setup-partners) and for the git hooks
# (`partners.py run`) alike, so a local commit or push is judged against the
# same partner commits as CI -- never against whatever the sibling checkouts
# happen to have checked out.
#
# KEY=VALUE lines only. SELF is this repository's directory in CI's sibling
# layout (molhub/, molpy/, molrs/), the layout the [tool.uv.sources] path
# dependencies in pyproject.toml expect.
#
# Partners are tracked, not pinned: <NAME>_REF is the partner's integration
# branch (dev) -- or the partner's branch of the same name as the one being
# built, when it has one (a change spanning both repositories). molrs is built
# from source (maturin), so CI sets up the Rust toolchain
# molrs/rust-toolchain.toml pins.
#
# The approved manifest database (MolCrafts/molhub-registry) is not a build
# partner: .github/actions/setup-registry checks it out as data.
SELF=molhub
MOLPY_REPOSITORY=MolCrafts/molpy
MOLPY_REF=dev
MOLRS_REPOSITORY=MolCrafts/molrs
MOLRS_REF=dev
